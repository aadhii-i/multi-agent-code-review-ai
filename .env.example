AZURE_OPENAI_API_KEY=your-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4-o
LANGGRAPH_URL=http://localhost:8001
LOG_LEVEL=INFO

# GitHub PR webhook integration
# Secret configured on the GitHub webhook (Settings > Webhooks) — used to
# verify the X-Hub-Signature-256 header via HMAC-SHA256.
GITHUB_WEBHOOK_SECRET=your-webhook-secret
# Personal access token (fine-grained: Pull requests read/write) or a
# GitHub App installation token. Needs `repo` scope (classic PAT) to read PR
# files and post reviews on private repos.
GITHUB_TOKEN=your-github-pat
